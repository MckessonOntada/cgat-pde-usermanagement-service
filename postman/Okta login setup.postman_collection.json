	"item": [
		{
			"name": "Okta Authenticate",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {\r",
							"    pm.environment.set(\"okta_session_token\", pm.response.json().sessionToken)\r",
							"    pm.environment.set(\"okta_user_id\", pm.response.json()._embedded.user.id)\r",
							"}\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Cookie",
						"value": "JSESSIONID=18C7669A191E3A6D50B597E3DA5DAC69"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"username\": \"{{okta_username}}\",\r\n    \"password\": \"{{okta_password}}\",\r\n    \"options\": {\r\n        \"multiOptionalFactorEnroll\": true,\r\n        \"warnBeforePasswordExpired\": true\r\n    }\r\n}\r\n"
				},
				"url": {
					"raw": "https://ikmg2.oktapreview.com//api/v1/authn",
					"protocol": "https",
					"host": [
						"ikmg2",
						"oktapreview",
						"com"
					],
					"path": [
						"",
						"api",
						"v1",
						"authn"
					]
				}
			},
			"response": []
		},
		{
			"name": "Generate Authentication Token",
