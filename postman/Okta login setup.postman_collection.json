					"listen": "test",
					"script": {
						"exec": [
							"if (pm.response.code === 200) {\r",
							"        const $ = cheerio.load(pm.response.text());\r",
							"        pm.environment.set(\"AUTH_TOKEN\", $('input[name=\"access_token\"]').val())\r",
							"    }"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
